                <table class="chart-values">
                    <tbody>
                        <tr><td>model_f0</td><td class="value">{{ row.f0_mhz|e }}</td><td class="unit">MHz</td></tr>
                        <tr><td>model_BSWR2_62</td><td class="value">{{ row.bswr_khz|e }}</td><td class="unit">kHz</td></tr>
                        <tr><td>model_alpha</td><td class="value">{{ row.alpha_db|e }}</td><td class="unit">db</td></tr>
                        {% if vna_cable_data %}
                        <tr><td>alpha datasheet</td><td class="value">{{ row.alpha_db_datasheet|e }}</td><td class="unit">db</td></tr>
                        {% endif %}
                        <tr><td>model_tau</td><td class="value">{{ row.tau_ns|e }}</td><td class="unit">ns</td></tr>
                        {% if vna_cable_data %}
                        <tr><td>tau datasheet</td><td class="value">{{ row.tau_ns_datasheet|e }}</td><td class="unit">ns</td></tr>
                        {% endif %}
                        <tr><td>SWR_min</td><td class="value">{{ row.swr_min|e }}</td><td class="unit"></td></tr>
                        <tr><td>eta_SWR_ant</td><td class="value">{{ row.eta_swr_ant|e }}</td><td class="unit"></td></tr>
                    </tbody>
                </table>
            </td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
