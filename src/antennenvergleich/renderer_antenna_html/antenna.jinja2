<!-- Automatically generated file by run_2_html.py. Do not edit manually. -->
<!doctype html>
<html lang=\"de\">
<head>
    <meta charset=\"utf-8\">
    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
    <title>{{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}} - antenna</title>
    <link rel="stylesheet" href="{{antenna_css_rel}}">
</head>
<body>

<h1>{{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}}</h1>

{% for src in antenna.overview_pictures %}
<p>
    <a href="{{src}}"><img class="overview-antenna-picture" src="{{src}}"></a>
</p>
{% endfor %}

<p>Info: {{antenna.info_str}}<br>
Conductor: {{antenna.info_str}}<br>
Capacitor: {{antenna.info_capacitor_str}}<br>
Enviroment: {{antenna.info_enviroment_str}}<br>
{% if antenna.info_thanks_str: %}
Thanks: {{antenna.info_thanks_str}}<br>
{% endif %}

<h2>Antenna Efficiency Overview</h2>
<table class="compact">
    <tbody>
        {% if efficency_table.columns %}
        <tr class="band-row">
            <td>Band</td>
            <td class="unit"></td>
            {% for column in efficency_table.columns %}
            <td class="val">{{ column|e }}</td>
            {% endfor %}
        </tr>
        {% else %}
        <tr>
            <td colspan="3">{{ efficency_table.empty_message|e }}</td>
        </tr>
        {% endif %}

        {% for row in efficency_table.rows %}
            <tr{% if row.css_class %} class="{{ row.css_class }}"{% endif %}>
                <td title="{{ row.tooltip|e }}">{{ row.label_html }}</td>
                <td class="unit">{{ row.unit_html }}</td>
                {% for cell in row.cells %}
                    <td class="{{ cell.css_class }}"{% if cell.colspan > 1 %} colspan="{{ cell.colspan }}"{% endif %} title="{{ cell.tooltip|e }}">{{ cell.value|e }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
</table>
{% if measurement_section_html %}
{{ measurement_section_html }}
{% endif %}
{% if environment_section_html %}
{{ environment_section_html }}
{% endif %}
{% if vna_filelist_section.rows %}
<h2>VNA-measurements</h2>
The antenna S11 parameters were measured with a VNA. <br>
The following values were derived from these measurements.<br>
Details on the measurement method can be found <a href="http://www.positron.ch/rf/vna_to_measure_loop_antenna/pdf/measure_a_magnetic_loop.pdf">here</a>.<br>
{{ vna_calibration_html }}
<table class="compact">
    <thead>
        <tr>
            <th>File</th>
            <th>model_f0<br>MHz</th>
            <th>model_BSWR2_62<br>kHz</th>
            <th>model_alpha<br>db</th>
            <th>model_tau<br>ns</th>
            <th>SWR_min</th>
            <th>eta_SWR_ant</th>
        </tr>
    </thead>
    <tbody>
        {% for row in vna_filelist_section.rows %}
        <tr>
            <td>{{ row.file_name|e }}</td>
            <td>{{ row.f0_mhz|e }}</td>
            <td>{{ row.bswr_khz|e }}</td>
            <td>{{ row.alpha_db|e }}</td>
            <td>{{ row.tau_ns|e }}</td>
            <td>{{ row.swr_min|e }}</td>
            <td>{{ row.eta_swr_ant|e }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

{% if vna_smith_section.rows %}
<p> </p>
<p>The following diagrams: red points = measured values; green line = fitted model.</p>
<table class="charts">
    <thead>
        <tr>
            <th>Smith</th>
            <th>SWR</th>
        </tr>
    </thead>
    <tbody>
        {% for row in vna_smith_section.rows %}
        <tr>
            <td><h3>{{ row.label|e }}</h3><a href="{{ row.smith_rel|e }}"><img src="{{ row.smith_rel|e }}" alt="{{ row.label|e }} smith"></a></td>
            <td><h3>{{ row.label|e }}</h3><a href="{{ row.swr_rel|e }}"><img src="{{ row.swr_rel|e }}" alt="{{ row.label|e }} swr"></a></td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% if inductance_section_html %}
{{ inductance_section_html }}
{% endif %}
</body>