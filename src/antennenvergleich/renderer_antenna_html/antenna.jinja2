<!-- Automatically generated file by run_2_html.py. Do not edit manually. -->
<!doctype html>
<html lang=\"de\">
<head>
    <meta charset=\"utf-8\">
    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
    <title>{{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}} - antenna</title>
    <link rel="stylesheet" href="{{antenna_css_rel}}">
</head>
<body>

<h1>{{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}}</h1>

{% for src in antenna.overview_pictures %}
<p>
    <a href="{{src}}"><img class="overview-antenna-picture" src="{{src}}"></a>
</p>
{% endfor %}

<p>Info: {{antenna.info_str}}<br>
Conductor: {{antenna.info_str}}<br>
Capacitor: {{antenna.info_capacitor_str}}<br>
Enviroment: {{antenna.info_enviroment_str}}<br>
{% if antenna.info_thanks_str: %}
Thanks: {{antenna.info_thanks_str}}<br>
{% endif %}

<h2>Antenna Efficiency Overview</h2>
<table class="compact">
    <tbody>
        {% if efficency_table.columns %}
        <tr class="band-row">
            <td>Band</td>
            <td class="unit"></td>
            {% for column in efficency_table.columns %}
            <td class="val">{{ column|e }}</td>
            {% endfor %}
        </tr>
        {% else %}
        <tr>
            <td colspan="3">{{ efficency_table.empty_message|e }}</td>
        </tr>
        {% endif %}

        {% for row in efficency_table.rows %}
            <tr{% if row.css_class %} class="{{ row.css_class }}"{% endif %}>
                <td title="{{ row.tooltip|e }}">{{ row.label_html }}</td>
                <td class="unit">{{ row.unit_html }}</td>
                {% for cell in row.cells %}
                    <td class="{{ cell.css_class }}"{% if cell.colspan > 1 %} colspan="{{ cell.colspan }}"{% endif %} title="{{ cell.tooltip|e }}">{{ cell.value|e }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
</table>
</body>