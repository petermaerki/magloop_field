<!-- Automatically generated file by run_2_html.py. Do not edit manually. -->
<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}} - antenna</title>
    <link rel="stylesheet" href="{{antenna_css_rel}}">
</head>
<body>

<h1>{{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}}</h1>

{% for src in antenna.overview_pictures %}
<p>
    <a href="{{src}}"><img class="overview-antenna-picture" src="{{src}}"></a>
</p>
{% endfor %}

<p>Info: {{antenna.info_str}}<br>
Conductor: {{antenna.info_conductor_str}}<br>
Capacitor: {{antenna.info_capacitor_str}}<br>
Enviroment: {{antenna.info_enviroment_str}}<br>
{% if antenna.info_thanks_str: %}
Thanks: {{antenna.info_thanks_str}}<br>
{% endif %}

<h2>Antenna Efficiency Overview</h2>
<table class="compact">
    <tbody>
        {% if efficiency_table.columns %}
        <tr class="band-row">
            <td>Band</td>
            <td class="unit"></td>
            {% for column in efficiency_table.columns %}
            <td class="val">{{ column|e }}</td>
            {% endfor %}
        </tr>
        {% else %}
        <tr>
            <td colspan="3">{{ efficiency_table.empty_message|e }}</td>
        </tr>
        {% endif %}

        {% for row in efficiency_table.rows %}
            <tr{% if row.css_class %} class="{{ row.css_class }}"{% endif %}>
                <td title="{{ row.tooltip|e }}">{{ row.label_html }}</td>
                <td class="unit">{{ row.unit_html }}</td>
                {% for cell in row.cells %}
                    <td class="{{ cell.css_class }}"{% if cell.colspan > 1 %} colspan="{{ cell.colspan }}"{% endif %} title="{{ cell.tooltip|e }}">{{ cell.value|e }}</td>
                {% endfor %}
            </tr>
        {% endfor %}
    </tbody>
</table>
{% if build_details_section_html %}
{{ build_details_section_html }}
{% endif %}
{% if environment_section_html %}
{{ environment_section_html }}
{% endif %}
{% if measurement_section_html %}
{{ measurement_section_html }}
{% endif %}
{% if vna_filelist_section.rows %}
<h2>VNA measurements ({{ vna_info|e }})</h2>
The antenna S11 parameters were measured with {{ vna_info|e }}. <br>
The following values were derived from these measurements.<br>
Details on the measurement method can be found <a href="http://www.positron.ch/rf/vna_to_measure_loop_antenna/pdf/measure_a_magnetic_loop.pdf">here</a>.<br>
{% if vna_calibration_mode == "antenna_feed_point" %}
<p>{% if vna_calibration_href %}<a href="{{ vna_calibration_href|e }}"><img class="vna-calibration-picture" src="{{ vna_calibration_href|e }}" alt="VNA calibration: fusspunkt_vna.svg"></a><br>{% endif %}
The calibration of {{ vna_info|e }} was done at the antenna feed point: green line.<br>
Common-mode choke at the antenna: <a href="http://www.positron.ch/rf/choke_simple">positron.ch/rf/choke_simple</a>.<br>
Used cables: 80 cm RG400 (including the choke) and 10 m LMR195.<br>
The cable attenuation alpha and the cable delay tau in the following table should therefore be small.</p>
{% elif vna_calibration_mode == "at_vna" %}
<p>{% if vna_calibration_href %}<a href="{{ vna_calibration_href|e }}"><img class="vna-calibration-picture" src="{{ vna_calibration_href|e }}" alt="VNA calibration: kabel_vna.svg"></a><br>{% endif %}
The calibration was done directly at {{ vna_info|e }}: green line. The cable influence was measured and removed.<br>
The cable attenuation alpha and the cable delay tau in the following table show the estimated cable values based on the {{ vna_info|e }} measurement.</p>
{% endif %}
<table class="compact">
    <thead>
        <tr>
            <th>File</th>
            <th>model_f0<br>MHz</th>
            <th>model_BSWR2_62<br>kHz</th>
            <th>model_alpha<br>db</th>
            <th>model_tau<br>ns</th>
            <th>SWR_min</th>
            <th>eta_SWR_ant</th>
        </tr>
    </thead>
    <tbody>
        {% for row in vna_filelist_section.rows %}
        <tr>
            <td>{{ row.file_name|e }}</td>
            <td>{{ row.f0_mhz|e }}</td>
            <td>{{ row.bswr_khz|e }}</td>
            <td>{{ row.alpha_db|e }}</td>
            <td>{{ row.tau_ns|e }}</td>
            <td>{{ row.swr_min|e }}</td>
            <td>{{ row.eta_swr_ant|e }}</td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}

{% if vna_smith_section.rows %}
<p> </p>
<p>The following diagrams: red points = measured values; green line = fitted model.</p>
<table class="charts">
    <thead>
        <tr>
            <th>Smith</th>
            <th>SWR</th>
        </tr>
    </thead>
    <tbody>
        {% for row in vna_smith_section.rows %}
        <tr>
            <td><h3>{{ row.label|e }}</h3><a href="{{ row.smith_rel|e }}"><img src="{{ row.smith_rel|e }}" alt="{{ row.label|e }} smith"></a></td>
            <td><h3>{{ row.label|e }}</h3><a href="{{ row.swr_rel|e }}"><img src="{{ row.swr_rel|e }}" alt="{{ row.label|e }} swr"></a></td>
        </tr>
        {% endfor %}
    </tbody>
</table>
{% endif %}
{% if inductance_section_html %}
{{ inductance_section_html }}
{% endif %}
{% if h_field_section_html %}
{{ h_field_section_html }}
{% endif %}
<p>All antennas overview: <a href="{{ compare_overview_href|e }}">compare page</a></p>
</body>
</html>