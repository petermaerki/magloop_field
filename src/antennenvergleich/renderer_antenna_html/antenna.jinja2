<!doctype html>
<html lang="de">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Magnetic Loop Antenna {{antenna.selection_brand}} {{antenna.selection_name}} {{antenna.selection_location}} - antenna</title>
    <link rel="stylesheet" href="{{antenna_css_rel}}">
    <meta name="keywords" content="Magnetic,Loop, Antenna, HB9ISP, Efficiency,{{ antenna.selection_brand|e }}, {{ antenna.selection_name|e }}, {{ antenna.selection_location|e }}">
