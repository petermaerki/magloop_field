  antenna_dir = mazzoni_midi_loop

build src/antennen/mazzoni_midi_loop_HB0SM/antenna_ninja_generated.html: run_ninja_page src/antennen/mazzoni_midi_loop_HB0SM/antennendaten.py src/antennen/mazzoni_midi_loop_HB0SM/antenna_efficiency_table_generated.html src/antennen/mazzoni_midi_loop_HB0SM/enviroment_generated.html src/antennen/mazzoni_midi_loop_HB0SM/vna_measurements_generated.html src/antennen/mazzoni_midi_loop_HB0SM/h_field_generated.html .ninja/run_2_html.stamp
