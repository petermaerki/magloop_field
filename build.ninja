build src/antennen/peter_tubby_indoor/antenna_ninja_generated.html: run_ninja_page src/antennen/peter_tubby_indoor/antennendaten.py src/antennen/peter_tubby_indoor/antenna_efficiency_table_generated.html src/antennen/peter_tubby_indoor/enviroment_generated.html src/antennen/peter_tubby_indoor/vna_measurements_generated.html src/antennen/peter_tubby_indoor/h_field_generated.html .ninja/run_2_html.stamp
  antenna_dir = peter_tubby_indoor

build src/antennen/peter_tubby_outdoor/antenna_ninja_generated.html: run_ninja_page src/antennen/peter_tubby_outdoor/antennendaten.py src/antennen/peter_tubby_outdoor/antenna_efficiency_table_generated.html src/antennen/peter_tubby_outdoor/enviroment_generated.html src/antennen/peter_tubby_outdoor/vna_measurements_generated.html src/antennen/peter_tubby_outdoor/h_field_generated.html .ninja/run_2_html.stamp
  antenna_dir = peter_tubby_outdoor

build ninja_pages: phony src/antennen/dk3ss_0_86_n2/antenna_ninja_generated.html src/antennen/dk3ss_1_25_n2/antenna_ninja_generated.html src/antennen/epicenter_W6NBC/antenna_ninja_generated.html src/antennen/mazzoni_baby_loop/antenna_ninja_generated.html src/antennen/mazzoni_baby_loop_HB0SM/antenna_ninja_generated.html src/antennen/mazzoni_midi_loop/antenna_ninja_generated.html src/antennen/mazzoni_midi_loop_HB0SM/antenna_ninja_generated.html src/antennen/mazzoni_stealth/antenna_ninja_generated.html src/antennen/mazzoni_stealth_HE9DJB/antenna_ninja_generated.html src/antennen/peter_tubby_indoor/antenna_ninja_generated.html src/antennen/peter_tubby_outdoor/antenna_ninja_generated.html

build html_pipeline: phony .ninja/run_0_s1p.stamp .ninja/run_2_html.stamp

build all: phony html_pipeline ninja_pages

default all
