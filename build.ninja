build src/antennen/mazzoni_stealth_HE9DJB/antenna_ninja_generated.html: run_ninja_page src/antennen/mazzoni_stealth_HE9DJB/antennendaten.py src/antennen/mazzoni_stealth_HE9DJB/antenna_efficiency_table_generated.html src/antennen/mazzoni_stealth_HE9DJB/enviroment_generated.html src/antennen/mazzoni_stealth_HE9DJB/vna_measurements_generated.html src/antennen/mazzoni_stealth_HE9DJB/h_field_generated.html .ninja/run_2_html.stamp
